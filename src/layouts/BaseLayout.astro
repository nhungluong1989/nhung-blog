---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  wide?: boolean;
}
const { title, description, ogType, wide = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} ogType={ogType} />
  </head>
  <body>
    <Header wide={wide} />
    <main class={wide ? 'wrap wrap-wide' : 'wrap'}>
      <slot />
    </main>
    <Footer wide={wide} />

    <script>
      import mermaid from 'mermaid';

      const diagrams = document.querySelectorAll('.mermaid');
      if (diagrams.length) {
        mermaid.initialize({
          startOnLoad: false,
          theme: 'base',
          themeVariables: {
            background: '#12161c',
            primaryColor: '#1b1f26',
            primaryTextColor: '#eceff2',
            primaryBorderColor: '#00ac76',
            lineColor: '#9399a1',
            secondaryColor: '#1b1f26',
            tertiaryColor: '#05070c',
            fontFamily: '"IBM Plex Sans", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif',
          },
        });
        mermaid.run({ nodes: diagrams }).then(() => {
          diagrams.forEach((container) => {
            const svg = container.querySelector('svg');
            if (!svg) return;

            const MIN = 0.5;
            const MAX = 3;
            const STEP = 0.2;
            let scale = 1;

            svg.style.transformOrigin = '0 0';
            svg.style.transition = 'transform 0.15s ease';
            svg.style.cursor = 'grab';

            const applyScale = () => {
              svg.style.transform = `scale(${scale})`;
            };

            const makeButton = (label, ariaLabel, onClick) => {
              const btn = document.createElement('button');
              btn.type = 'button';
              btn.textContent = label;
              btn.setAttribute('aria-label', ariaLabel);
              btn.addEventListener('click', onClick);
              return btn;
            };

            const controls = document.createElement('div');
            controls.className = 'mermaid-zoom-controls';
            controls.append(
              makeButton('−', 'Zoom out', () => {
                scale = Math.max(MIN, +(scale - STEP).toFixed(2));
                applyScale();
              }),
              makeButton('reset', 'Reset zoom', () => {
                scale = 1;
                applyScale();
                container.scrollLeft = 0;
                container.scrollTop = 0;
              }),
              makeButton('+', 'Zoom in', () => {
                scale = Math.min(MAX, +(scale + STEP).toFixed(2));
                applyScale();
              }),
            );
            controls.children[1].classList.add('mermaid-zoom-reset');
            container.appendChild(controls);

            container.addEventListener(
              'wheel',
              (e) => {
                if (!e.ctrlKey && !e.metaKey) return;
                e.preventDefault();
                scale =
                  e.deltaY < 0
                    ? Math.min(MAX, +(scale + STEP).toFixed(2))
                    : Math.max(MIN, +(scale - STEP).toFixed(2));
                applyScale();
              },
              { passive: false },
            );

            let isDragging = false;
            let startX = 0;
            let startY = 0;
            let startScrollLeft = 0;
            let startScrollTop = 0;

            container.addEventListener('mousedown', (e) => {
              isDragging = true;
              svg.style.cursor = 'grabbing';
              startX = e.pageX;
              startY = e.pageY;
              startScrollLeft = container.scrollLeft;
              startScrollTop = container.scrollTop;
            });
            window.addEventListener('mouseup', () => {
              isDragging = false;
              svg.style.cursor = 'grab';
            });
            window.addEventListener('mousemove', (e) => {
              if (!isDragging) return;
              container.scrollLeft = startScrollLeft - (e.pageX - startX);
              container.scrollTop = startScrollTop - (e.pageY - startY);
            });
          });
        });
      }
    </script>

    <script>
      // Add a "copy" button to every fenced code block.
      document.querySelectorAll('.article-body pre').forEach((pre) => {
        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.type = 'button';
        btn.textContent = 'copy';
        btn.addEventListener('click', async () => {
          const code = pre.querySelector('code');
          await navigator.clipboard.writeText(code ? code.innerText : pre.innerText);
          btn.textContent = 'copied';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = 'copy';
            btn.classList.remove('copied');
          }, 1500);
        });
        pre.appendChild(btn);
      });
    </script>
  </body>
</html>

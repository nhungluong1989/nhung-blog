---
interface Props {
  wide?: boolean;
}
const { wide = false } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class={wide ? 'wrap wrap-wide wrap-offset' : 'wrap'}>
    <span class="footer-prompt">nhungluong@blog:~$ <span class="cursor">_</span></span>
    <span>
      &copy; {year} Nhung Luong &middot; <a href="/rss.xml">RSS</a> &middot; Built with Astro
    </span>
  </div>
</footer>

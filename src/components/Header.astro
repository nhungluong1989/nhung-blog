---
interface Props {
  wide?: boolean;
  offset?: boolean;
}
const { wide = false, offset = false } = Astro.props;
---
<header class="site-header">
  <div class={wide ? `wrap wrap-wide${offset ? ' wrap-offset' : ''}` : 'wrap'}>
    <a href="/" class="brand">Nhung Luong</a>
    <nav class="nav">
      <a href="/">Blog</a>
      <a href="/about">About</a>
    </nav>
  </div>
</header>

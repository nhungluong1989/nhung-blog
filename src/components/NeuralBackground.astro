---
interface Props {
  id: string;
}
const { id } = Astro.props;
---
<canvas id={id} class="neural-canvas" aria-hidden="true"></canvas>

<script define:vars={{ id }}>
  const canvas = document.getElementById(id);
  const section = canvas?.parentElement;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && section && !reduceMotion) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      let particles = [];
      let pulses = [];
      let width = 0;
      let height = 0;
      let linkDist = 150;
      let mouseRadius = 120;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const MAX_SPEED = 0.6;
      const mouse = { x: -9999, y: -9999 };

      function resize() {
        width = section.clientWidth;
        height = section.clientHeight;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        // Scale link/mouse radius to the shorter side so thin headers don't
        // turn into a dense scribble of overlapping lines.
        const short = Math.min(width, height);
        linkDist = Math.max(50, Math.min(150, short * 0.75));
        mouseRadius = Math.max(50, Math.min(120, short * 0.6));
      }

      function initParticles() {
        const count = Math.min(60, Math.max(8, Math.floor((width * height) / 13000)));
        particles = Array.from({ length: count }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.3,
          vy: (Math.random() - 0.5) * 0.3,
          r: 1.2 + Math.random() * 1.6,
        }));
        pulses = [];
      }

      function tick() {
        ctx.clearRect(0, 0, width, height);

        for (const p of particles) {
          const dx = p.x - mouse.x;
          const dy = p.y - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < mouseRadius && dist > 0.01) {
            const force = (1 - dist / mouseRadius) * 0.045;
            p.vx += (dx / dist) * force;
            p.vy += (dy / dist) * force;
          }
          const speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
          if (speed > MAX_SPEED) {
            p.vx = (p.vx / speed) * MAX_SPEED;
            p.vy = (p.vy / speed) * MAX_SPEED;
          }
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0 || p.x > width) p.vx *= -1;
          if (p.y < 0 || p.y > height) p.vy *= -1;
          p.vx *= 0.996;
          p.vy *= 0.996;
        }

        const edges = [];
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const a = particles[i];
            const b = particles[j];
            const dx = a.x - b.x;
            const dy = a.y - b.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < linkDist) {
              ctx.strokeStyle = `rgba(65, 235, 176, ${(1 - dist / linkDist) * 0.3})`;
              ctx.lineWidth = 1;
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.stroke();
              edges.push([i, j]);
            }
          }
        }

        if (edges.length && pulses.length < 6 && Math.random() < 0.04) {
          const [i, j] = edges[Math.floor(Math.random() * edges.length)];
          const flip = Math.random() < 0.5;
          pulses.push({
            fromIdx: flip ? i : j,
            toIdx: flip ? j : i,
            t: 0,
            speed: 0.012 + Math.random() * 0.012,
          });
        }

        pulses = pulses.filter((pulse) => {
          const a = particles[pulse.fromIdx];
          const b = particles[pulse.toIdx];
          if (!a || !b) return false;
          pulse.t += pulse.speed;
          if (pulse.t >= 1) return false;
          const x = a.x + (b.x - a.x) * pulse.t;
          const y = a.y + (b.y - a.y) * pulse.t;
          ctx.beginPath();
          ctx.fillStyle = 'rgba(120, 255, 210, 0.95)';
          ctx.shadowColor = 'rgba(65, 235, 176, 0.9)';
          ctx.shadowBlur = 7;
          ctx.arc(x, y, 2, 0, Math.PI * 2);
          ctx.fill();
          ctx.shadowBlur = 0;
          return true;
        });

        for (const p of particles) {
          ctx.beginPath();
          ctx.fillStyle = 'rgba(65, 235, 176, 0.65)';
          ctx.shadowColor = 'rgba(65, 235, 176, 0.7)';
          ctx.shadowBlur = 5;
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();
          ctx.shadowBlur = 0;
        }

        requestAnimationFrame(tick);
      }

      resize();
      initParticles();
      requestAnimationFrame(tick);

      section.addEventListener('mousemove', (e) => {
        const rect = section.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      });
      section.addEventListener('mouseleave', () => {
        mouse.x = -9999;
        mouse.y = -9999;
      });

      let resizeTimer;
      function scheduleResize() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          const prevHeight = height;
          resize();
          // Only reseed particles if the size actually changed meaningfully
          // (avoids resetting the animation on every tiny observer tick).
          if (Math.abs(height - prevHeight) > 1 || particles.length === 0) {
            initParticles();
          }
        }, 120);
      }

      window.addEventListener('resize', scheduleResize);

      // Re-measure whenever the container's own size changes for any reason
      // (e.g. an image inside it finishing load and growing the section),
      // not just on window resize.
      if (window.ResizeObserver) {
        new ResizeObserver(scheduleResize).observe(section);
      }
    }
  }
</script>

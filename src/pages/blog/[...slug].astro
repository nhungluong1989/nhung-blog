---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import NeuralBackground from '../../components/NeuralBackground.astro';
import Subscribe from '../../components/Subscribe.astro';
import { getMinutes } from '../../utils/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const minutes = getMinutes(post.body);
const dateStr = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const hasToc = headings.some((h) => h.depth === 2 || h.depth === 3);
---
<BaseLayout title={post.data.title} description={post.data.description} ogType="article" wide={hasToc}>
  <div class={hasToc ? 'post-wrap has-toc' : 'post-wrap'}>
    <article class="article">
      <header class="article-header">
        <NeuralBackground id="article-canvas" />
        <p class="post-date">{dateStr} &middot; {minutes} min read</p>
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          {post.data.tags.map((t) => <span class="tag">#{t.replace(/\s+/g, '-')}</span>)}
        </div>
      </header>
      <hr class="divider" />
      <div class="article-body">
        <Content />
      </div>
      <Subscribe />
      <p style="margin-top:1.5rem;"><a href="/">&larr; Back to all posts</a></p>
    </article>
    {hasToc && (
      <aside class="toc-sidebar">
        <TableOfContents headings={headings} />
      </aside>
    )}
  </div>
</BaseLayout>
